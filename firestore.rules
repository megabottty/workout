rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ── Private workout data ─────────────────────────────────────────────────
    match /users/{userId}/workouts/{workoutId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/programBlocks/{programBlockId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Profile: owner writes; anyone authenticated reads (needed for friend UX)
    match /users/{userId}/profile/data {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Public profile index for friend search ───────────────────────────────
    match /publicProfiles/{uid} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // ── Friend requests ──────────────────────────────────────────────────────
    // Doc ID is "{fromUid}_{toUid}"
    match /friendRequests/{requestId} {
      // Allow point-reads for IDs that include the current uid so sender-side
      // duplicate checks can read non-existent docs safely.
      allow get: if request.auth != null
                 && (
                   (resource != null
                    && (resource.data.fromUid == request.auth.uid
                        || resource.data.toUid  == request.auth.uid))
                   || requestId.matches('^' + request.auth.uid + '_.*')
                   || requestId.matches('^.*_' + request.auth.uid + '$')
                 );
      allow list: if request.auth != null
                  && (resource.data.fromUid == request.auth.uid
                      || resource.data.toUid  == request.auth.uid);
      // Create: must be sender
      allow create: if request.auth != null
                    && request.resource.data.fromUid == request.auth.uid
                    && request.resource.data.toUid != request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.keys().hasOnly([
                      'fromUid',
                      'fromDisplayName',
                      'fromEmail',
                      'toUid',
                      'status',
                      'createdAt',
                      'updatedAt',
                    ]);
      // Update:
      // 1) Recipient can accept/decline pending requests.
      // 2) Either participant can unfriend by changing accepted -> declined.
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data).changedKeys().hasOnly(['status', 'updatedAt'])
                    && (
                      (
                        resource.data.toUid == request.auth.uid
                        && resource.data.status == 'pending'
                        && request.resource.data.status in ['accepted', 'declined']
                      )
                      ||
                      (
                        (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid)
                        && resource.data.status == 'accepted'
                        && request.resource.data.status == 'declined'
                      )
                    );
    }

    // ── User notifications ───────────────────────────────────────────────────
    match /users/{userId}/notifications/{notificationId} {
      allow get, list: if request.auth != null && request.auth.uid == userId;

      // Friend request notifications are written by the sender to the recipient inbox.
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.fromUid
                    && request.resource.data.toUid == userId
                    && request.resource.data.type == 'friend-request'
                    && request.resource.data.keys().hasOnly([
                      'type',
                      'toUid',
                      'fromUid',
                      'fromDisplayName',
                      'fromEmail',
                      'requestId',
                      'message',
                      'isRead',
                      'createdAt',
                      'updatedAt',
                    ]);

      // Recipient can mark notifications as read.
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.diff(resource.data).changedKeys().hasOnly(['isRead', 'updatedAt']);
    }

    // ── Shared workouts ──────────────────────────────────────────────────────
    match /sharedWorkouts/{workoutId} {
      // Owner can create/update own shares
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid;

      // Any authenticated user can read — feed filtering is done client-side
      // to friends only; the rule is permissive to allow cross-uid reads.
      allow read: if request.auth != null;

      // Owner can update fully; others may only update reactions and comments
      allow update: if request.auth != null
                    && (resource.data.ownerUid == request.auth.uid
                        || request.resource.data.keys().hasOnly(['reactions', 'comments', 'updatedAt']));
    }
  }
}
